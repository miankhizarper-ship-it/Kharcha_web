# ── Analytics (required for pageview/download tracking + dashboard) ──
# MongoDB Atlas connection string (server-side only — NEVER exposed to the
# browser). In Cloudflare this is a Worker VARIABLE/SECRET, not this file.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name (created automatically on first write)
MONGODB_DATABASE=kharcha_analytics
# Dashboard login at /admin/analytics
ANALYTICS_ADMIN_USERNAME=admin
ANALYTICS_ADMIN_PASSWORD=pick-a-long-random-password
# Signs the admin session cookie — any long random string
ANALYTICS_SESSION_SECRET=pick-another-long-random-string

# ── Optional ──
# Extra salt for the ephemeral IP hash used in rate limiting (never stored)
# ANALYTICS_IP_SALT=optional-random-string
# Auto-delete analytics older than N days (TTL indexes)
# ANALYTICS_RETENTION_DAYS=180

# ── In-app update system (optional — GET /api/app-version) ──
# Preferred source is the MongoDB `app_releases` collection (see README);
# these bindings act as an explicit override and survive database outages.
# APP_LATEST_VERSION=1.1.0
# APP_LATEST_VERSION_CODE=2
# APP_LATEST_APK_URL=https://direct-download-link/kharcha-1.1.0.apk
# APP_RELEASE_NOTES=["Added the in-app update system","Bug fixes"]
# APP_UPDATE_MANDATORY=false
# APP_RELEASE_SOURCE=environment
